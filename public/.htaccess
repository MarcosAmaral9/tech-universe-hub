# VicioCode .htaccess — segurança e HTTPS

# ── Canonicalização de host e protocolo ───────────────────────
# Objetivo: TODA requisição termina em https://viciocode.com/... (sem www),
# em um único salto 301. Host fixo para não depender de backreferences
# (LiteSpeed/Hostinger ignora %1 em alguns contextos).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www (http ou https) → raiz em HTTPS, salto único
  RewriteCond %{HTTP_HOST} ^www\.viciocode\.com$ [NC]
  RewriteRule ^ https://viciocode.com%{REQUEST_URI} [R=301,L,NE,QSA]

  # 2) HTTP → HTTPS (host raiz, já sem www)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://viciocode.com%{REQUEST_URI} [R=301,L,NE,QSA]

  # 3) Remove barra final de URLs (exceto raiz e diretórios reais) — evita duplicatas
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS só faz sentido (e só é válido) em resposta HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Permite popup OAuth do Google (login) sem quebrar isolamento
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Permite que assets sejam servidos a iframes do AdSense
  Header always set Cross-Origin-Resource-Policy "cross-origin"
  # Remove cabeçalhos que expõem informações do servidor
  Header always unset X-Powered-By
  Header always unset Server


  # Service Worker NUNCA pode ficar cacheado (senão SW antigo fica preso)
  <FilesMatch "^(sw|service-worker|push-handler|registerSW)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(manifest\.webmanifest|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # HTML (index.html e páginas pré-renderizadas) sempre revalidado —
  # evita HTML antigo apontando para /assets/*.js já removidos (tela preta)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # api.php nunca em cache de borda/navegador (dados de usuário)
  <FilesMatch "^api\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>

</IfModule>

# ── SPA: serve index.html para rotas React ────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Prioriza .html estático (posts e regiões gerados pelo build)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
  # Serve arquivos estáticos diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Fallback: todas as rotas → index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# ── Cache de assets estáticos ─────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ── Bloqueia acesso a arquivos sensíveis ──────────────────────
<FilesMatch "\.(env|log|sh|bak|sql|git|gitignore)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ── Bloqueia listagem de diretórios ───────────────────────────
Options -Indexes
